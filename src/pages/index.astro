---
import { AppPichangas } from '../components/AppPichangas';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pichangas Arequipa | Directorio de Canchas y Convocatorias</title>
    <script is:inline src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-slate-50 text-slate-900 antialiased selection:bg-emerald-500 selection:text-white">
    <!-- Hero Section Deportivo Oscuro -->
    <header class="relative bg-slate-900 text-white overflow-hidden border-b-4 border-emerald-500">
      <!-- Imagen de fondo de cancha nocturna -->
      <div class="absolute inset-0">
        <img
          src="https://images.unsplash.com/photo-1518605368461-1ee7e543b66f?auto=format&fit=crop&w=1600&q=80"
          alt="Cancha de grass sintético nocturna"
          class="w-full h-full object-cover opacity-35"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-slate-950/80 via-slate-900/75 to-slate-950/95"></div>
      </div>

      <!-- Contenido del Hero -->
      <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 text-center">
        <span class="inline-flex items-center gap-2 rounded-full bg-emerald-500/15 border border-emerald-400/30 px-4 py-1.5 text-xs sm:text-sm font-semibold text-emerald-300 mb-5 backdrop-blur-xs">
          📍 Arequipa, Perú • Canchas de Grass Sintético
        </span>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white mb-4">
          La pichanga no se cancela
        </h1>

        <p class="max-w-2xl mx-auto text-base sm:text-lg text-slate-300 leading-relaxed">
          Encuentra y reserva al instante en las mejores canchas cerca de{' '}
          <span class="text-white font-semibold">San Lázaro / UCSP, Cercado, Bustamante y Miraflores</span>,
          o completa los jugadores que te faltan para tu partido de hoy.
        </p>
      </div>
    </header>

    <!-- Aplicación Principal Interactiva -->
    <main>
      <AppPichangas client:load />
    </main>

    <!-- Pie de página -->
    <footer class="bg-slate-900 text-slate-400 border-t border-slate-800 py-8 text-center text-sm">
      <div class="max-w-7xl mx-auto px-4">
        <p class="font-medium text-slate-300">⚽ Pichangas Arequipa &copy; 2026</p>
        <p class="text-xs text-slate-500 mt-1">
          Directorio verificado de complejos deportivos y convocatorias en tiempo real.
        </p>
      </div>
    </footer>
  </body>
</html>
